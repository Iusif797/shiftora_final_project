  <developers>
    <developer>
      <id>iielse</id>
      <name>else</name>
      <email>517309507@qq.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/iielse/imageviewer.git</connection>
    <developerConnection>scm:git://github.com/iielse/imageviewer.git</developerConnection>
    <url>git://github.com/iielse/imageviewer.git</url>
  </scm>
