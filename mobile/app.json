{
  "expo": {
    "name": "Shiftora",
    "slug": "shiftora",
    "scheme": "shiftora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pro.itenterprise.shiftora",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en"
        ],
        "NSCameraUsageDescription": "Shiftora uses the camera to scan the check-in QR code at your restaurant and to take an optional photo when you clock in.",
        "NSLocationWhenInUseUsageDescription": "Shiftora uses your location while you clock in, to confirm that you are at the restaurant. Your location is not tracked in the background.",
        "NSPhotoLibraryUsageDescription": "Shiftora uses your photo library so that you can pick a profile picture and attach an image to a check-in.",
        "NSFaceIDUsageDescription": "Shiftora uses Face ID to protect the sign-in session stored securely on this device.",
        "NSMotionUsageDescription": "Shiftora uses motion data from your device so that location updates while you clock in are accurate and use less battery."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "buildNumber": "12"
    },
    "android": {
      "package": "pro.itenterprise.shiftora",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-mail-composer",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-ios-permission-strings"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cf5a87a-d1a0-4145-8118-386879538392"
      }
    },
    "owner": "it-enterprise"
  }
}
