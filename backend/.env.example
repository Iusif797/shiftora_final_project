# =============================================================================
# Shiftora Backend — Environment Variables
# =============================================================================
# Скопируйте этот файл в .env и заполните значения.
# Все переменные валидируются через Zod в src/env.ts при старте приложения.
# Если обязательная переменная отсутствует или невалидна — процесс упадёт.
# =============================================================================

# ─── Обязательные ────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Локально:    postgresql://postgres:postgres@localhost:5432/shiftora
# Supabase:    postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Railway/RDS: managed PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiftora

# Секрет для подписи Better Auth сессий и cookie.
# Сгенерировать: `openssl rand -hex 32`
# В production обязательно >= 32 символа, никогда не коммитить реальное значение.
BETTER_AUTH_SECRET=your-secret-key-min-32-chars

# ─── Сетевые / окружение ─────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# Порт, на котором запускается сервер (внутри контейнера).
PORT=3000

# Публичный URL бэкенда. Используется Better Auth для генерации ссылок
# (verification, password reset) и в трасте cookie.
# Production: https://api.shiftora.app
BACKEND_URL=http://localhost:3000

# Публичный URL фронтенда. Используется в email-шаблонах для CTA-ссылок
# и при редиректах после верификации/оплаты Stripe.
FRONTEND_URL=http://localhost:8081

# CSV-список разрешённых origin для CORS.
# В production задавайте ЯВНО — например: https://app.shiftora.app
# Если не задано в production, бэк отвечает 403 на cross-origin запросы.
# ALLOWED_ORIGIN=https://app.shiftora.app,https://shiftora.app

# ─── Email (Resend) ──────────────────────────────────────────────────────────

# API key из https://resend.com/api-keys.
# Используется для отправки писем верификации, приглашений, отчётов.
# Если не задан — email-верификация отключена в dev, в production — ошибка старта.
# RESEND_API_KEY=re_...

# Адрес отправителя. Должен быть на верифицированном в Resend домене.
# FROM_EMAIL=Shiftora <noreply@shiftora.app>

# ─── Мониторинг ──────────────────────────────────────────────────────────────

# Sentry DSN для бэкенда. Опционально, но настоятельно рекомендуется в production.
# SENTRY_DSN=https://...@sentry.io/...

# Уровень логирования pino: trace | debug | info | warn | error | fatal
# По умолчанию: debug в dev, info в production.
# LOG_LEVEL=info

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────

# API key из https://aistudio.google.com/apikey
# Если не задан — функционал AI insights / shift suggestions будет недоступен.
# GEMINI_API_KEY=

# ─── Stripe (биллинг подписок) ───────────────────────────────────────────────

# Если ни один из STRIPE_* не задан — биллинг работает в "free-only" режиме.
# Получить ключи: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_BUSINESS_PRICE_ID=price_...
