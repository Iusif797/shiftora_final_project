generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  manager
  employee
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum AnomalyType {
  LATE_ARRIVAL
  MISSED_SHIFT
  EARLY_LEAVE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanTier {
  free
  pro
  business
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  incomplete
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  pushToken     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          UserRole @default(employee)
  restaurantId  String?

  sessions      Session[]
  accounts      Account[]
  employee      Employee?
  restaurant    Restaurant?  @relation("owner")
  createdShifts Shift[]
  assets        Asset[]
  invitations   Invitation[] @relation("inviter")
  createdOrders Order[]

  @@index([restaurantId])
  @@index([email])
}

model Asset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId      String
  url         String
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  timezone  String   @default("UTC")
  latitude  Float?
  longitude Float?
  taxRate   Float    @default(0.1)
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User              @relation("owner", fields: [ownerId], references: [id])
  employees      Employee[]
  shifts         Shift[]
  checkins       Checkin[]
  anomalies      Anomaly[]
  invitations    Invitation[]
  subscription   Subscription?
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  tables         RestaurantTable[]
  orders         Order[]
}

model Employee {
  id           String   @id @default(cuid())
  userId       String   @unique
  restaurantId String
  position     String?
  hourlyRate   Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id])
  assignments ShiftAssignment[]
  checkins    Checkin[]
  anomalies   Anomaly[]

  @@index([restaurantId])
}

model Shift {
  id           String      @id @default(cuid())
  restaurantId String
  title        String
  startTime    DateTime
  endTime      DateTime
  status       ShiftStatus @default(SCHEDULED)
  notes        String?
  maxEmployees Int?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id])
  createdBy   User              @relation(fields: [createdById], references: [id])
  assignments ShiftAssignment[]

  @@index([restaurantId])
  @@index([startTime])
  @@index([restaurantId, startTime])
}

model ShiftAssignment {
  id         String           @id @default(cuid())
  shiftId    String
  employeeId String
  status     AssignmentStatus @default(ASSIGNED)
  createdAt  DateTime         @default(now())

  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])
  checkins  Checkin[]
  anomalies Anomaly[]

  @@unique([shiftId, employeeId])
  @@index([shiftId])
  @@index([employeeId])
}

model Checkin {
  id                String    @id @default(cuid())
  shiftAssignmentId String
  employeeId        String
  restaurantId      String
  checkinTime       DateTime  @default(now())
  checkoutTime      DateTime?
  notes             String?
  latitude          Float?
  longitude         Float?
  photoUrl          String?
  qrPayload         String?
  createdAt         DateTime  @default(now())

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])

  @@unique([shiftAssignmentId])
  @@index([restaurantId])
  @@index([employeeId])
  @@index([restaurantId, checkinTime])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

enum WebhookEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model StripeWebhookEvent {
  id          String             @id
  type        String
  status      WebhookEventStatus @default(PROCESSING)
  attempts    Int                @default(1)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
}

model Anomaly {
  id                String          @id @default(cuid())
  shiftAssignmentId String
  employeeId        String
  restaurantId      String
  type              AnomalyType
  severity          AnomalySeverity @default(MEDIUM)
  detectedAt        DateTime        @default(now())
  resolvedAt        DateTime?
  notes             String?
  isResolved        Boolean         @default(false)

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, isResolved])
}

model Subscription {
  id                   String             @id @default(cuid())
  restaurantId         String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 PlanTier           @default(free)
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([stripeCustomerId])
}

model Invitation {
  id           String           @id @default(cuid())
  code         String           @unique
  restaurantId String
  role         UserRole         @default(employee)
  status       InvitationStatus @default(PENDING)
  invitedBy    String
  usedBy       String?
  email        String?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  inviter    User       @relation("inviter", fields: [invitedBy], references: [id])

  @@index([code])
  @@index([restaurantId])
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  OPEN
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  NONE
  CASH
  CARD
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Float
  photoUrl     String?
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  number       Int
  label        String?
  capacity     Int         @default(4)
  status       TableStatus @default(FREE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

model Order {
  id                    String        @id @default(cuid())
  restaurantId          String
  tableId               String
  createdById           String
  status                OrderStatus   @default(OPEN)
  paymentMethod         PaymentMethod @default(NONE)
  paymentStatus         PaymentStatus @default(UNPAID)
  subtotal              Float         @default(0)
  taxAmount             Float         @default(0)
  totalAmount           Float         @default(0)
  stripeCheckoutSession String?
  notes                 String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  createdBy  User            @relation(fields: [createdById], references: [id])
  items      OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, status])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  menuItemId    String
  nameSnapshot  String
  priceSnapshot Float
  quantity      Int             @default(1)
  notes         String?
  status        OrderItemStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}
